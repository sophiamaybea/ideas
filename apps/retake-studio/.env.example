# Which image model backs the studio.
#   mock      -> no key, returns placeholder portraits (default; great for demos)
#   replicate -> real generation via Replicate
IMAGE_PROVIDER=mock

# --- Replicate (only if IMAGE_PROVIDER=replicate) ---
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: pin a specific identity-preserving portrait model version.
# REPLICATE_MODEL_VERSION=ddfc2b08d209f9fa8c1eca692712918bd449f695dabb4a958da31802a9570fe4

# Port for the local dev API server (npm run server)
PORT=8787
